   "source": [
    "import nltk\n",
    "import random\n",
    "\n",
    "nltk.download('names')\n",
    "\n",
    "from nltk.corpus import names\n",
    "\n",
    "male=[(n,'male') for n in names.words('male.txt')]\n",
    "\n",
    "female=[(n,'female') for n in names.words('female.txt')]\n",
    "\n",
    "combined=male+female\n",
    "\n",
    "random.shuffle(combined)\n",
    "\n",
    "print(combined[:15])\n"
   ]
  },
